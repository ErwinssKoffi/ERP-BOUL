# ERP-BOUL Configuration Environment Variables
NEXT_PUBLIC_APP_NAME="ERP-BOUL"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"
NEXT_PUBLIC_DEFAULT_LOCALE="fr-CI"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Security & Session
SESSION_SECRET="change-this-in-production-min-32-chars-long"

# Database (PostgreSQL Cloud SQL / Drizzle)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_boul"

# Gemini AI (Server-side proxy routes only)
GEMINI_API_KEY=""
